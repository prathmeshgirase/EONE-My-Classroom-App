POSTGRES_DB=eone
POSTGRES_USER=eone
POSTGRES_PASSWORD=eone
# Development only. Set a unique random secret before deployment.
EONE_JWT_SECRET=development-only-long-secret-development-only-long-secret-1234
EONE_SEED_ENABLED=true
EONE_CORS_ORIGINS=http://localhost:3000,http://localhost:8081


# Optional commands (run separately in a terminal, not as environment entries):
# docker compose up -d
# adb reverse tcp:18080 tcp:8081
# adb reverse --list
# docker compose logs -f backend
# cd mobile
# flutter run --dart-define=EONE_API_URL=http://127.0.0.1:18080/api/v1

# docker compose down
# docker compose ps
# Avoid docker compose down -v: it deletes the database volume.
